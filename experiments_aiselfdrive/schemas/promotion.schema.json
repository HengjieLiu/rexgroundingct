{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rexgroundingct.local/schemas/promotion.schema.json",
  "title": "ReXGroundingCT portfolio promotion decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "source",
    "registry_revision",
    "portfolio_sha256",
    "plan_sha256",
    "t3_evidence_sha256",
    "rank",
    "promoted_at",
    "matched_control_required",
    "val120_access_authorized",
    "treatment_arm_id",
    "matched_control_arm_id",
    "policy",
    "barrier",
    "candidates",
    "selected_ids",
    "record_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "experiment_id": {"type": "string", "pattern": "^asd_[0-9]{3}_[a-z0-9_]+$"},
    "source": {"const": "experimentctl promote"},
    "registry_revision": {"type": "integer", "minimum": 1},
    "portfolio_sha256": {"$ref": "#/$defs/sha256"},
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "t3_evidence_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "rank": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 1}]},
    "promoted_at": {"type": "string", "format": "date-time"},
    "matched_control_required": {"type": "boolean"},
    "val120_access_authorized": {"type": "boolean"},
    "treatment_arm_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "matched_control_arm_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "policy": {
      "type": "object",
      "additionalProperties": true,
      "required": ["max_t4_interventions"],
      "properties": {"max_t4_interventions": {"type": "integer", "minimum": 0, "maximum": 2}}
    },
    "barrier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completed_at", "all_t3_terminal", "candidate_ids"],
      "properties": {
        "completed_at": {"type": "string", "format": "date-time"},
        "all_t3_terminal": {"const": true},
        "candidate_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "eligible", "safety_pass", "dice_delta", "off_location_fp_reduction", "gpu_hours", "rank", "selected", "barrier_reason", "t3_evidence_path", "t3_evidence_sha256"],
        "properties": {
          "id": {"type": "string"},
          "eligible": {"type": "boolean"},
          "safety_pass": {"type": "boolean"},
          "dice_delta": {"type": "number", "minimum": -1, "maximum": 1},
          "off_location_fp_reduction": {"type": "number", "minimum": -1, "maximum": 1},
          "gpu_hours": {"type": "number", "minimum": 0},
          "rank": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 1}]},
          "selected": {"type": "boolean"},
          "barrier_reason": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
          "t3_evidence_path": {"oneOf": [{"type": "null"}, {"type": "string"}]},
          "t3_evidence_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]}
        }
      }
    },
    "selected_ids": {"type": "array", "uniqueItems": true, "maxItems": 2, "items": {"type": "string"}},
    "record_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
