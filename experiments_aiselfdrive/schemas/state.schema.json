{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rexgroundingct.local/schemas/state.schema.json",
  "title": "ReXGroundingCT AI self-drive mutable state",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "experiment_id",
    "plan_sha256",
    "plan_revision",
    "revision",
    "status",
    "outcome",
    "created_at",
    "updated_at",
    "current_stage_id",
    "executor",
    "blockers",
    "stages",
    "artifacts_verified",
    "closeout_passed"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "experiment_id": {
      "type": "string",
      "pattern": "^asd_[0-9]{3}_[a-z0-9_]+$"
    },
    "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "plan_revision": {"type": "integer", "minimum": 1},
    "revision": {"type": "integer", "minimum": 0},
    "last_event_seq": {"type": "integer", "minimum": 0},
    "phase": {"type": "string", "minLength": 1},
    "status": {
      "enum": [
        "draft",
        "ready",
        "claimed",
        "running",
        "retry_wait",
        "blocked",
        "stopping",
        "finished"
      ]
    },
    "outcome": {
      "oneOf": [
        {"type": "null"},
        {
          "enum": [
            "go",
            "no_go",
            "inconclusive",
            "failed",
            "cancelled",
            "invalid"
          ]
        }
      ]
    },
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "current_stage_id": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
      ]
    },
    "executor": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/executor"}
      ]
    },
    "lease": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/executor"}
      ]
    },
    "blockers": {
      "type": "array",
      "items": {"$ref": "#/$defs/blocker"}
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/stage_state"}
    },
    "artifacts_verified": {"type": "boolean"},
    "closeout_passed": {"type": "boolean"},
    "budget_consumed": {"type": "object", "additionalProperties": true},
    "verified_artifact_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
    },
    "obligation_projection": {
      "$ref": "#/$defs/obligation_projection"
    },
    "plan_history": {
      "type": "array",
      "items": {"$ref": "#/$defs/plan_history_entry"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "obligation_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claims_sha256",
        "artifacts_sha256",
        "claim_ids",
        "claim_types",
        "artifact_ids",
        "required_artifact_ids",
        "static_artifact_ids",
        "pinned_at"
      ],
      "properties": {
        "claims_sha256": {"$ref": "#/$defs/sha256"},
        "artifacts_sha256": {"$ref": "#/$defs/sha256"},
        "claim_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
        },
        "claim_types": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["feasibility", "mechanistic", "causal", "performance", "safety"]
          }
        },
        "artifact_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
        },
        "required_artifact_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
        },
        "static_artifact_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
        },
        "pinned_at": {"type": "string", "format": "date-time"}
      }
    },
    "plan_history_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan_revision",
        "plan_sha256",
        "previous_plan_source",
        "archived_plan_path",
        "archived_plan_sha256",
        "archived_plan_size_bytes",
        "archived_state_path",
        "archived_state_sha256",
        "archived_state_size_bytes",
        "archived_result_path",
        "archived_result_sha256",
        "archived_result_size_bytes",
        "archived_claims_path",
        "archived_artifacts_path",
        "previous_claims_sha256",
        "previous_claims_size_bytes",
        "previous_artifacts_sha256",
        "previous_artifacts_size_bytes",
        "current_claims_sha256",
        "current_artifacts_sha256",
        "previous_budget_consumed",
        "carried_budget_consumed",
        "replanned_at"
      ],
      "properties": {
        "plan_revision": {"type": "integer", "minimum": 1},
        "plan_sha256": {"$ref": "#/$defs/sha256"},
        "previous_plan_source": {"type": "string", "minLength": 1},
        "archived_plan_path": {"type": "string", "minLength": 1},
        "archived_plan_sha256": {"$ref": "#/$defs/sha256"},
        "archived_plan_size_bytes": {"type": "integer", "minimum": 0},
        "archived_state_path": {"type": "string", "minLength": 1},
        "archived_state_sha256": {"$ref": "#/$defs/sha256"},
        "archived_state_size_bytes": {"type": "integer", "minimum": 0},
        "archived_result_path": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "minLength": 1}
          ]
        },
        "archived_result_sha256": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]
        },
        "archived_result_size_bytes": {
          "oneOf": [{"type": "null"}, {"type": "integer", "minimum": 0}]
        },
        "archived_claims_path": {"type": "string", "minLength": 1},
        "archived_artifacts_path": {"type": "string", "minLength": 1},
        "previous_claims_sha256": {"$ref": "#/$defs/sha256"},
        "previous_claims_size_bytes": {"type": "integer", "minimum": 0},
        "previous_artifacts_sha256": {"$ref": "#/$defs/sha256"},
        "previous_artifacts_size_bytes": {"type": "integer", "minimum": 0},
        "current_claims_sha256": {"$ref": "#/$defs/sha256"},
        "current_artifacts_sha256": {"$ref": "#/$defs/sha256"},
        "previous_budget_consumed": {"$ref": "#/$defs/resource_totals"},
        "carried_budget_consumed": {"$ref": "#/$defs/resource_totals"},
        "replanned_at": {"type": "string", "format": "date-time"}
      }
    },
    "resource_totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gpu_hours", "cpu_hours", "storage_gib"],
      "properties": {
        "gpu_hours": {"type": "number", "minimum": 0},
        "cpu_hours": {"type": "number", "minimum": 0},
        "storage_gib": {"type": "number", "minimum": 0}
      }
    },
    "executor": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "agent_id",
        "lease_id",
        "lease_path",
        "container_label_key",
        "container_label_value",
        "claimed_at",
        "heartbeat_at"
      ],
      "properties": {
        "agent_id": {"type": "string", "minLength": 1},
        "lease_id": {"type": "string", "minLength": 1},
        "lease_path": {"type": "string", "minLength": 1},
        "container_label_key": {"const": "rexgroundingct.aiselfdrive.lease"},
        "container_label_value": {"type": "string", "minLength": 1},
        "claimed_at": {"type": "string", "format": "date-time"},
        "heartbeat_at": {"type": "string", "format": "date-time"}
      }
    },
    "blocker": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": true
        }
      ]
    },
    "stage_state": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "status",
        "attempts",
        "started_at",
        "completed_at",
        "last_error",
        "evidence_refs"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "status": {
          "enum": [
            "pending",
            "ready",
            "running",
            "retry_wait",
            "blocked",
            "passed",
            "failed",
            "skipped"
          ]
        },
        "attempts": {"type": "integer", "minimum": 0},
        "started_at": {
          "oneOf": [{"type": "null"}, {"type": "string", "format": "date-time"}]
        },
        "completed_at": {
          "oneOf": [{"type": "null"}, {"type": "string", "format": "date-time"}]
        },
        "last_error": {
          "oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": true}]
        },
        "retry_not_before": {
          "oneOf": [{"type": "null"}, {"type": "string", "format": "date-time"}]
        },
        "resource_wait_started_at": {
          "oneOf": [{"type": "null"}, {"type": "string", "format": "date-time"}]
        },
        "evidence_refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "failure_evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
