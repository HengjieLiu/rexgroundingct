{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rexgroundingct.local/schemas/state.schema.json",
  "title": "ReXGroundingCT AI self-drive mutable state",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "experiment_id",
    "plan_sha256",
    "plan_revision",
    "revision",
    "status",
    "outcome",
    "created_at",
    "updated_at",
    "current_stage_id",
    "executor",
    "blockers",
    "stages",
    "artifacts_verified",
    "closeout_passed"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "experiment_id": {
      "type": "string",
      "pattern": "^asd_[0-9]{3}_[a-z0-9_]+$"
    },
    "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "plan_revision": {"type": "integer", "minimum": 1},
    "revision": {"type": "integer", "minimum": 0},
    "last_event_seq": {"type": "integer", "minimum": 0},
    "phase": {"type": "string", "minLength": 1},
    "status": {
      "enum": [
        "draft",
        "ready",
        "claimed",
        "running",
        "retry_wait",
        "blocked",
        "stopping",
        "finished"
      ]
    },
    "outcome": {
      "oneOf": [
        {"type": "null"},
        {
          "enum": [
            "go",
            "no_go",
            "inconclusive",
            "failed",
            "cancelled",
            "invalid"
          ]
        }
      ]
    },
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "current_stage_id": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
      ]
    },
    "executor": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/executor"}
      ]
    },
    "lease": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/executor"}
      ]
    },
    "blockers": {
      "type": "array",
      "items": {"$ref": "#/$defs/blocker"}
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/stage_state"}
    },
    "artifacts_verified": {"type": "boolean"},
    "closeout_passed": {"type": "boolean"},
    "budget_consumed": {"type": "object", "additionalProperties": true},
    "verified_artifact_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
    }
  },
  "$defs": {
    "executor": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "agent_id",
        "lease_id",
        "lease_path",
        "claimed_at",
        "heartbeat_at"
      ],
      "properties": {
        "agent_id": {"type": "string", "minLength": 1},
        "lease_id": {"type": "string", "minLength": 1},
        "lease_path": {"type": "string", "minLength": 1},
        "claimed_at": {"type": "string", "format": "date-time"},
        "heartbeat_at": {"type": "string", "format": "date-time"}
      }
    },
    "blocker": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": true
        }
      ]
    },
    "stage_state": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "status",
        "attempts",
        "started_at",
        "completed_at",
        "last_error",
        "evidence_refs"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "status": {
          "enum": [
            "pending",
            "ready",
            "running",
            "retry_wait",
            "blocked",
            "passed",
            "failed",
            "skipped"
          ]
        },
        "attempts": {"type": "integer", "minimum": 0},
        "started_at": {
          "oneOf": [{"type": "null"}, {"type": "string", "format": "date-time"}]
        },
        "completed_at": {
          "oneOf": [{"type": "null"}, {"type": "string", "format": "date-time"}]
        },
        "last_error": {
          "oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": true}]
        },
        "evidence_refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
